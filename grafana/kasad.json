{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus scraping kasad",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "11.0.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "stat",
      "name": "Stat",
      "version": ""
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": ""
    },
    {
      "type": "panel",
      "id": "bargauge",
      "name": "Bar gauge",
      "version": ""
    },
    {
      "type": "panel",
      "id": "state-timeline",
      "name": "State timeline",
      "version": ""
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Devices not answering or without a good poll for 2 minutes, Wi-Fi below −75 dBm, mains outside 114–126 V (ANSI ±5 %), 10+ failed polls in the last hour, failing remote-write pushes, or kasad not reporting. A device that has never answered shows by IP.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "orange",
            "mode": "fixed"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "All clear"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "green",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "name",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "label_replace(max by (name) (label_replace(label_replace(kasa_up == 0, \"name\", \"$1\", \"host\", \"(.*)\"), \"name\", \"$1\", \"alias\", \"(.+)\")), \"issue\", \"not answering\", \"\", \"\")\nor label_replace(max by (name) (label_replace(label_replace(time() - kasa_last_success_timestamp_seconds > 120 unless on (host) kasa_up == 0, \"name\", \"$1\", \"host\", \"(.*)\"), \"name\", \"$1\", \"alias\", \"(.+)\")), \"issue\", \"no good poll for 2m+\", \"\", \"\")\nor label_replace(max by (name) (label_replace(label_replace(kasa_rssi_dbm < -75, \"name\", \"$1\", \"host\", \"(.*)\"), \"name\", \"$1\", \"alias\", \"(.+)\")), \"issue\", \"weak Wi-Fi (below −75 dBm)\", \"\", \"\")\nor label_replace(max by (name) (label_replace(label_replace(kasa_voltage_volts < 114 or kasa_voltage_volts > 126, \"name\", \"$1\", \"host\", \"(.*)\"), \"name\", \"$1\", \"alias\", \"(.+)\")), \"issue\", \"mains voltage outside 114–126 V\", \"\", \"\")\nor label_replace(sum by (name) (label_replace(label_replace(increase(kasa_poll_errors_total[1h]), \"name\", \"$1\", \"host\", \"(.*)\"), \"name\", \"$1\", \"alias\", \"(.+)\")) > 10, \"issue\", \"flaky: 10+ failed polls in the last hour\", \"\", \"\")\nor label_replace(label_replace(max by (target) (increase(kasad_push_errors_total[10m])) > 0, \"name\", \"kasad\", \"\", \"\"), \"issue\", \"push to $1 failing\", \"target\", \"(.*)\")\nor label_replace(label_replace(absent(kasad_devices), \"name\", \"kasad\", \"\", \"\"), \"issue\", \"not reporting\", \"\", \"\")",
          "instant": true,
          "legendFormat": "{{name}}: {{issue}}",
          "range": false,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "absent(\nlabel_replace(max by (name) (label_replace(label_replace(kasa_up == 0, \"name\", \"$1\", \"host\", \"(.*)\"), \"name\", \"$1\", \"alias\", \"(.+)\")), \"issue\", \"not answering\", \"\", \"\")\nor label_replace(max by (name) (label_replace(label_replace(time() - kasa_last_success_timestamp_seconds > 120 unless on (host) kasa_up == 0, \"name\", \"$1\", \"host\", \"(.*)\"), \"name\", \"$1\", \"alias\", \"(.+)\")), \"issue\", \"no good poll for 2m+\", \"\", \"\")\nor label_replace(max by (name) (label_replace(label_replace(kasa_rssi_dbm < -75, \"name\", \"$1\", \"host\", \"(.*)\"), \"name\", \"$1\", \"alias\", \"(.+)\")), \"issue\", \"weak Wi-Fi (below −75 dBm)\", \"\", \"\")\nor label_replace(max by (name) (label_replace(label_replace(kasa_voltage_volts < 114 or kasa_voltage_volts > 126, \"name\", \"$1\", \"host\", \"(.*)\"), \"name\", \"$1\", \"alias\", \"(.+)\")), \"issue\", \"mains voltage outside 114–126 V\", \"\", \"\")\nor label_replace(sum by (name) (label_replace(label_replace(increase(kasa_poll_errors_total[1h]), \"name\", \"$1\", \"host\", \"(.*)\"), \"name\", \"$1\", \"alias\", \"(.+)\")) > 10, \"issue\", \"flaky: 10+ failed polls in the last hour\", \"\", \"\")\nor label_replace(label_replace(max by (target) (increase(kasad_push_errors_total[10m])) > 0, \"name\", \"kasad\", \"\", \"\"), \"issue\", \"push to $1 failing\", \"target\", \"(.*)\")\nor label_replace(label_replace(absent(kasad_devices), \"name\", \"kasad\", \"\", \"\"), \"issue\", \"not reporting\", \"\", \"\")\n)",
          "instant": true,
          "legendFormat": "All clear",
          "range": false,
          "refId": "B"
        }
      ],
      "title": "Needs attention",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Combined draw of the metered plugs. Wall switches don't meter, so lights on switches aren't counted.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "blue",
            "mode": "fixed"
          },
          "decimals": 0,
          "unit": "watt"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 0,
        "y": 3
      },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(kasa_power_watts{model!~\"KS.*\", model!=\"\"})",
          "instant": false,
          "legendFormat": "total",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Drawing now",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Metered plugs only, from each device's own counter (device resets are handled).",
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "unit": "kwatth"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 5,
        "y": 3
      },
      "id": 3,
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(increase(kasa_energy_watt_hours_total[$__range])) / 1000",
          "instant": true,
          "legendFormat": "total",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Energy in time range",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Relays currently on, plugs and switches.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "yellow",
            "mode": "fixed"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 10,
        "y": 3
      },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "count(kasa_relay_on == 1) or vector(0)",
          "instant": false,
          "legendFormat": "on",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Switched on",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "not answering"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "text",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 15,
        "y": 3
      },
      "id": 5,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "value_and_name",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(kasa_up)",
          "instant": true,
          "legendFormat": "answering",
          "range": false,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "count(kasa_up == 0) or vector(0)",
          "instant": true,
          "legendFormat": "not answering",
          "range": false,
          "refId": "B"
        }
      ],
      "title": "Devices",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Average across metered plugs.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "text",
                "value": 114
              },
              {
                "color": "red",
                "value": 126
              }
            ]
          },
          "unit": "volt"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 3
      },
      "id": 6,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "avg(kasa_voltage_volts)",
          "instant": false,
          "legendFormat": "avg",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Mains",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Stacked: the top edge is the total metered draw.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic-by-name"
          },
          "custom": {
            "fillOpacity": 60,
            "lineInterpolation": "stepAfter",
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal"
            }
          },
          "min": 0,
          "unit": "watt"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 10,
        "w": 16,
        "x": 0,
        "y": 7
      },
      "id": 7,
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "sortBy": "Mean",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (alias) (kasa_power_watts{model!~\"KS.*\", model!=\"\"})",
          "instant": false,
          "legendFormat": "{{alias}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Power by plug",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "blue",
            "mode": "fixed"
          },
          "decimals": 2,
          "min": 0,
          "unit": "suffix: kWh"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 10,
        "w": 8,
        "x": 16,
        "y": 7
      },
      "id": 8,
      "options": {
        "displayMode": "basic",
        "namePlacement": "left",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showUnfilled": true,
        "valueMode": "text"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sort_desc(sum by (alias) (increase(kasa_energy_watt_hours_total[$__range])) / 1000)",
          "instant": true,
          "legendFormat": "{{alias}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Energy by plug (time range)",
      "type": "bargauge"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Wall switches. Dimmers are shaded by brightness: darker = dimmer.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 0
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "transparent",
                  "index": 0,
                  "text": "off"
                },
                "100": {
                  "index": 1,
                  "text": "on"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "semi-dark-yellow",
                "value": 1
              },
              {
                "color": "yellow",
                "value": 40
              },
              {
                "color": "light-yellow",
                "value": 80
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 13,
        "w": 12,
        "x": 0,
        "y": 17
      },
      "id": 9,
      "options": {
        "alignValue": "left",
        "legend": {
          "showLegend": false
        },
        "mergeValues": true,
        "rowHeight": 0.85,
        "showValue": "never",
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by (alias) (\n    max by (alias, host) (kasa_relay_on{model=~\"KS.*\"} == 0)\n  or max by (alias, host) (kasa_brightness_percent{model=~\"KS.*\"}) and on (host) max by (alias, host) (kasa_relay_on{model=~\"KS.*\"} == 1)\n  or max by (alias, host) (kasa_relay_on{model=~\"KS.*\"} == 1) * 100\n)",
          "instant": false,
          "legendFormat": "{{alias}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Lights & switches",
      "type": "state-timeline"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Relay state. A plug that's on can still draw nothing if the appliance is idle.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "#808080",
            "mode": "fixed"
          },
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 0
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "transparent",
                  "index": 0,
                  "text": "off"
                },
                "1": {
                  "color": "blue",
                  "index": 1,
                  "text": "on"
                }
              },
              "type": "value"
            }
          ]
        },
        "overrides": []
      },
      "gridPos": {
        "h": 13,
        "w": 12,
        "x": 12,
        "y": 17
      },
      "id": 10,
      "options": {
        "alignValue": "left",
        "legend": {
          "showLegend": false
        },
        "mergeValues": true,
        "rowHeight": 0.85,
        "showValue": "never",
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by (alias) (kasa_relay_on{model!~\"KS.*\", model!=\"\"})",
          "instant": false,
          "legendFormat": "{{alias}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Plugs",
      "type": "state-timeline"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 30
      },
      "id": 14,
      "panels": [],
      "title": "Network & polling",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Average across metered plugs (leaving out the 3 highest and 3 lowest when 10 or more plugs report, so one plug's local sag doesn't drag it), smoothed with a 30-minute moving average.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 0,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false,
            "lineInterpolation": "smooth"
          },
          "decimals": 1,
          "unit": "volt"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "avg"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "blue",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 31
      },
      "id": 12,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "min",
            "max",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "avg_over_time((avg(kasa_voltage_volts unless on (host) (bottomk(3, kasa_voltage_volts) or topk(3, kasa_voltage_volts))) and count(kasa_voltage_volts) >= 10 or avg(kasa_voltage_volts))[30m:1m])",
          "instant": false,
          "legendFormat": "avg",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Mains voltage",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Red below −75 dBm, orange below −67.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "max": -20,
          "min": -90,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": -75
