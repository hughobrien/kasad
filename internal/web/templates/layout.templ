package templates

import (
	"strconv"

	"github.com/hughobrien/kasad/internal/web/ui"
)

// BuildID names this build. The page carries it in a meta tag and the event
// stream checks it on every (re)connect, so a tab left open across a deploy
// reloads itself instead of mixing new markup with old CSS.
var BuildID = "dev"

templ Page(p ui.PageView) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>kasad</title>
			<meta name="build" content={ BuildID }/>
			<link rel="icon" href="/ui/static/favicon.svg" type="image/svg+xml"/>
			<link rel="stylesheet" href="/ui/static/style.css"/>
			<script type="module" src="/ui/static/datastar.js"></script>
		</head>
		<body data-init="@get('/ui/sse', {retry: 'always', retryMaxCount: 100000, retryMaxWait: 5000})">
			<header>
				<h1>kasad</h1>
				@Summary(p)
			</header>
			@Devices(p.Cards)
		</body>
	</html>
}

// Summary is the header line: combined draw and how many devices answer.
templ Summary(p ui.PageView) {
	<p id="summary" class="summary">
		<b>{ p.TotalPower }</b>
		<span>{ strconv.Itoa(p.UpCount) } of { strconv.Itoa(p.Total) } up</span>
	</p>
}

// Devices is the card grid. It is always rendered whole (never empty), so
// the event stream can replace it when devices come and go.
templ Devices(cs []ui.CardView) {
	<main id="devices">
		for _, c := range cs {
			@Card(c)
		}
	</main>
}
