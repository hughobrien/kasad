package templates

import (
	"strconv"

	"github.com/hughobrien/kasad/internal/web/ui"
)

templ Card(c ui.CardView) {
	<section id={ c.ID } class={ "card", templ.KV("offline", !c.Up) }>
		<div class="head">
			<h2>{ c.Name }</h2>
			@powerToggle(c)
		</div>
		<div class="sub">
			{ c.Kind }
			if c.Via != "" {
				<span class="via">· via { c.Via }</span>
			}
		</div>
		if c.Dimmable && c.Up && c.Brightness > 0 {
			<label class="dim">
				<input
					type="range"
					min="1"
					max="100"
					step="1"
					aria-label="Brightness"
					id={ "bright-" + c.ID + "-" + strconv.Itoa(c.Brightness) }
					value={ strconv.Itoa(c.Brightness) }
					data-ignore-morph
					data-on:input="el.nextElementSibling.textContent = el.value + '%'"
					data-on:change={ "@post('/ui/devices/" + c.Host + "/brightness?pct=' + el.value)" }
				/>
				<output>{ strconv.Itoa(c.Brightness) }%</output>
			</label>
		}
		if !c.Up {
			<p class="offline-note">Offline · last seen { c.LastSeen }</p>
		} else {
			<dl>
				if c.Power != "" {
					<dt>Power</dt>
					<dd class="watts">{ c.Power }</dd>
				}
				if c.Today != "" {
					<dt>Today</dt>
					<dd>{ c.Today }</dd>
				}
				if c.Month != "" {
					<dt>This month</dt>
					<dd>{ c.Month }</dd>
				}
				if c.RSSI != "" {
					<dt>Signal</dt>
					<dd>{ c.RSSI }</dd>
				}
			</dl>
		}
		if c.Err != "" {
			<p class="ctl-error" role="alert">{ c.Err }</p>
		}
	</section>
}

// powerToggle asks for the opposite of the state the device last reported.
// The card is replaced by the next SSE patch, which drops the pending class.
templ powerToggle(c ui.CardView) {
	<button
		type="button"
		class="power-toggle"
		aria-pressed={ strconv.FormatBool(c.On) }
		disabled?={ !c.Up || !c.HasState }
		data-on:click={ "el.classList.add('pending'); @post('/ui/devices/" + c.Host + "/relay?on=" + strconv.FormatBool(!c.On) + "')" }
	>
		if c.On {
			On
		} else {
			Off
		}
	</button>
}
